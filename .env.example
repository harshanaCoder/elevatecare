DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=elevatecare_db
PORT=5000

# Single shared admin login. Generate the hash with:
#   node scripts/hash-password.js "YourNewPassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional second account, restricted to reports.html only — see
# ROLE_ACCESS in src/server.js. Leave both blank to disable this role.
REPORTS_USERNAME=
REPORTS_PASSWORD_HASH=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
