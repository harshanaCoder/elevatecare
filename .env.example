DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=elevatecare_db
PORT=5000

# Single shared admin login. Generate the hash with:
#   node scripts/hash-password.js "YourNewPassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional second account, restricted to reports.html only — see
# ROLE_ACCESS in src/server.js. Leave both blank to disable this role.
REPORTS_USERNAME=
REPORTS_PASSWORD_HASH=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to true once the site is served over HTTPS (Caddyfile switched to a real
# domain). Leave false/blank on plain HTTP — a secure cookie is never sent
# over HTTP, so login would silently stop working.
COOKIE_SECURE=false

# Shared secret the technicians' mobile app sends in the x-api-key header when
# it posts a breakdown to /api/mobile/breakdowns. Leave blank to disable mobile
# submissions entirely. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MOBILE_API_KEY=

# OPTIONAL but recommended on a server: a limited MySQL account for the app
# (read/write rows only — no DROP/CREATE, no other databases) so the web app never
# connects as root. Letters, digits, _ and - only. Created automatically the first
# time the database volume is created; see db/create-app-user.sh for existing DBs.
# Leave blank to keep using root (DB_PASSWORD) as before.
APP_DB_USER=
APP_DB_PASSWORD=
